[iftech_servers]
instance-a ansible_host=18.206.100.10 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/id_iftech
instance-b ansible_host=18.206.100.11 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/id_iftech

[iftech_servers:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'